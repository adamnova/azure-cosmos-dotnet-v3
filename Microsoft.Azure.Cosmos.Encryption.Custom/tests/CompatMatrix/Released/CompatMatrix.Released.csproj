<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CompatMatrix.Released</AssemblyName>
    <RootNamespace>CompatMatrix</RootNamespace>
    <DefineConstants>$(DefineConstants);COMPAT_RELEASED</DefineConstants>
    <SignAssembly>false</SignAssembly>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <CompatMatrixRole>released</CompatMatrixRole>
    <CompatMatrixPackageVersion>1.0.0-preview07</CompatMatrixPackageVersion>
    <CompatMatrixPackageSource Condition="'$(CompatMatrixReleasedPackageSource)' != ''">$(CompatMatrixReleasedPackageSource)</CompatMatrixPackageSource>
    <CompatMatrixPackageSource Condition="'$(CompatMatrixPackageSource)' == ''">https://api.nuget.org/v3/index.json</CompatMatrixPackageSource>
    <CompatMatrixTransitivePackageSource Condition="'$(CompatMatrixTransitivePackageSource)' == ''">$(CompatMatrixPackageSource)</CompatMatrixTransitivePackageSource>
    <CompatMatrixExpectedPackageSha256>121AA0ED2A518D1F791992AC4E6A90B8E3A16A9BEDE4CB719F6156CF384398F8</CompatMatrixExpectedPackageSha256>
    <CompatMatrixSourceCommit>released-nuget-package</CompatMatrixSourceCommit>
  </PropertyGroup>

  <Import Project="..\Worker\CompatMatrix.Worker.targets" />
</Project>
