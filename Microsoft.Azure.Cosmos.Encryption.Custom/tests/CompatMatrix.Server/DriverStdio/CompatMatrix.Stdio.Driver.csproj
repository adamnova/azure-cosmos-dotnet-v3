<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPIKE (Option C) driver: stdio/NDJSON transport. Same shared MatrixRunner as the HTTP driver;
       only the INode implementation (StdioNode) differs. No dependency on Encryption.Custom. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompatMatrix.Stdio.Driver</AssemblyName>
    <RootNamespace>CompatMatrix.Server.StdioDriver</RootNamespace>
    <SignAssembly>false</SignAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\driver-shared\*.cs" />
  </ItemGroup>

</Project>
