<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone restore config for the compat-matrix SERVER spike (Option B).
     OLD (1.0.0-preview07) comes from nuget.org, NEW (1.1.0-preview01) from the local feed.
     Same feed-mapping approach as tests/CompatMatrix/nuget.config: the Encryption.Custom id must
     be resolvable from BOTH feeds so each project resolves its pinned version from whichever feed
     has it. All other transitive deps come from nuget.org. The Driver has no local-feed dependency. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="..\..\..\..\local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.Azure.Cosmos.Encryption.Custom" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="Microsoft.Azure.Cosmos.Encryption.Custom" />
    </packageSource>
  </packageSourceMapping>
</configuration>
