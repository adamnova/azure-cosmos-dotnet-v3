<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- SPIKE NEW shim: Microsoft.Azure.Cosmos.Encryption.Custom 1.1.0-preview01 from the local feed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CompatMatrix.Server.New</AssemblyName>
    <RootNamespace>CompatMatrix.Server</RootNamespace>
    <DefineConstants>$(DefineConstants);CEC_NEW</DefineConstants>
    <SignAssembly>false</SignAssembly>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shim\MatrixCore.cs" Link="MatrixCore.cs" />
    <Compile Include="..\shim\KeyProviders.cs" Link="KeyProviders.cs" />
    <Compile Include="..\shim\Shim.cs" Link="Shim.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos.Encryption.Custom" Version="[$(CompatMatrixNewVersion)]" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
