<Project>

  <!-- Import the inherited chain (Encryption.Custom -> repo root) so shared build settings still apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Single source of the two compat-matrix package pins. CI overrides CompatMatrixNewVersion with a
       commit-qualified package identity; local builds retain the fixed preview01 default. The values are
       embedded as assembly metadata so workers, drivers, and tests use the same version guards as restore. -->
  <PropertyGroup>
    <CompatMatrixOldVersion>1.0.0-preview07</CompatMatrixOldVersion>
    <CompatMatrixNewVersion Condition="'$(CompatMatrixNewVersion)' == ''">1.1.0-preview01</CompatMatrixNewVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CompatMatrixOldVersion</_Parameter1>
      <_Parameter2>$(CompatMatrixOldVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CompatMatrixNewVersion</_Parameter1>
      <_Parameter2>$(CompatMatrixNewVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
