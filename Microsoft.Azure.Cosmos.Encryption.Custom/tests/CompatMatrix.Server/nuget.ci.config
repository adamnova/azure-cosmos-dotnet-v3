<?xml version="1.0" encoding="utf-8"?>
<!-- CI restore config for the compat-matrix SERVER spike. Same mapping as nuget.config, except the
     NEW package (1.1.0-preview01) resolves from a feed given by the COMPATMATRIX_FEED environment
     variable instead of the developer local feed. A CI leg packs the in-repo Encryption.Custom
     source (which versions to 1.1.0-preview01) into a folder and sets COMPATMATRIX_FEED to it, so CI
     needs no checked-in local feed. OLD (preview07) still comes from nuget.org. Pass this file via
     the dotnet restore/test configfile switch. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="compat-feed" value="%COMPATMATRIX_FEED%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.Azure.Cosmos.Encryption.Custom" />
    </packageSource>
    <packageSource key="compat-feed">
      <package pattern="Microsoft.Azure.Cosmos.Encryption.Custom" />
    </packageSource>
  </packageSourceMapping>
</configuration>
