<?xml version="1.0" encoding="utf-8"?>
<!-- CI restore config for the compat-matrix SERVER spike. Same mapping as nuget.config, except the
     commit-qualified NEW package resolves from a feed given by the COMPATMATRIX_FEED environment
     variable instead of the developer local feed. CI packs the in-repo Encryption.Custom source
     with CompatMatrixNewVersion into that folder, so it needs no checked-in local feed. OLD
     (preview07) still comes from nuget.org. Pass this file via the dotnet restore/test configfile
     switch. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="compat-feed" value="%COMPATMATRIX_FEED%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.Azure.Cosmos.Encryption.Custom" />
    </packageSource>
    <packageSource key="compat-feed">
      <package pattern="Microsoft.Azure.Cosmos.Encryption.Custom" />
    </packageSource>
  </packageSourceMapping>
</configuration>
